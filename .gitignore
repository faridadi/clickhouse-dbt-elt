# =============================================================================
# Secrets & environment
# =============================================================================
# Never commit real credentials. env.example is the tracked template.
.env
*.env
!env.example

# =============================================================================
# Runtime data volumes (bind mounts)
# =============================================================================
# Created and owned by the database containers themselves. They must NOT be
# tracked, and must NOT contain a .gitkeep either: Postgres initdb refuses to
# initialise a directory that is not empty.
postgres/pg_data/
clickhouse/ch_data/

# =============================================================================
# Airflow runtime
# =============================================================================
# Logs now live in the airflow_logs named volume, so nothing here is needed at runtime.
airflow-dbt/logs/
airflow-dbt/plugins/*
!airflow-dbt/plugins/.gitkeep

airflow.db
airflow.cfg
airflow-webserver.pid
webserver_config.py
standalone_admin_password.txt
simple_auth_manager_passwords.json.generated
airflow_settings.yaml

# =============================================================================
# dbt artefacts
# =============================================================================
# Regenerated by every run; the manifest Cosmos uses is built inside the image.
# The dbt log path is spelled out in full rather than as a bare `logs/`, which would
# match every directory of that name anywhere in the tree.
target/
dbt_packages/
airflow-dbt/dbt/lion_parcel_project/logs/
.user.yml

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# =============================================================================
# Assessment material
# =============================================================================
# The brief belongs to Lion Parcel. Keep it out of a public repository.
DE Lion Parcel Test.pdf
*.pdf

# =============================================================================
# Agent tooling & local editor state
# =============================================================================
.agents/
AGENTS.md
skills-lock.json
astro
.vscode/
.idea/
.DS_Store
